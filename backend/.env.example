PORT=3001
# Comma-separated list of browser origins allowed to call this API.
# - Local development: defaults to http://localhost:3000 if unset.
# - Production: REQUIRED. Wildcard (*) is rejected at startup - list explicit
#   origins instead, e.g. https://app.splitnaira.com,https://splitnaira.com
# CORS credentials (cookies) are never enabled - auth uses a bearer token in
# the Authorization header, so Access-Control-Allow-Credentials is always
# omitted regardless of this setting. See docs/backend-deploy.md#cors-configuration.
CORS_ORIGIN=http://localhost:3000

LOG_LEVEL=info
# Set to "json" in production for structured/searchable logs (e.g. Render log drain).
# Set to "pretty" (default) for human-readable coloured output in development.
LOG_FORMAT=pretty

DATABASE_URL=postgresql://user:password@localhost:5432/splitnaira
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
CONTRACT_ID=
SIMULATOR_ACCOUNT=

# Error monitoring (optional — leave blank to disable Sentry)
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=production
# SENTRY_SCRUB_WALLET_ADDRESSES=true

# Wallet & payments admin controls
# Required in production to protect /splits/admin operations.
# PAYMENTS_ADMIN_API_KEY=replace-with-long-random-secret
# Set to false to freeze admin payout/allowlist mutation routes without redeploying code.
# PAYMENTS_ADMIN_WRITE_ENABLED=true

# Response validation (optional)
# Set to "true" to hard-fail (500) on response schema mismatch. Defaults to true in production.
# STRICT_RESPONSE_VALIDATION=true

# Email change confirmation (optional, Issue #1448)
# How long the confirmation link sent to the new address stays valid.
# EMAIL_CHANGE_TOKEN_TTL=24h
# Page the link opens; it receives ?token=... (not accepted from API requests).
# EMAIL_CHANGE_URL_BASE=https://app.splitnaira.com/confirm-email-change

# Performance tuning (optional)
# READ_CACHE_TTL_MS=30000
# READ_CACHE_MAX_ENTRIES=500
# DATABASE_POOL_MAX=10

# Degraded-mode health thresholds (optional, Issue #935)
# GET /health/ready reports a dependency as "degraded" (still 200, not 503)
# when it responds successfully but slower than these thresholds; it reports
# "down" (503) only on an outright error/timeout. See docs/runbooks/observability.md.
# HEALTH_DB_DEGRADED_LATENCY_MS=500
# HEALTH_RPC_DEGRADED_LATENCY_MS=1500

# Health check timeouts (optional, Issue #843)
# Per-dependency readiness check deadlines in milliseconds. A hung DB or RPC
# fails fast at these thresholds rather than blocking the readiness endpoint.
# HEALTH_DB_CHECK_TIMEOUT_MS=2000
# HEALTH_RPC_CHECK_TIMEOUT_MS=5000

# Request body size limit
# Maximum JSON payload size accepted by the API (applied via express.json).
# Oversized payloads are rejected with a 413 (Payload Too Large) response.
# Default: 1mb (1048576 bytes). Supported suffixes: kb, mb, gb.
# BODY_SIZE_LIMIT=1mb
// SplitNaira is in active development. This repo currently contains:

// - `contracts/` Soroban smart contract and tests
// - `frontend/` Next.js + Tailwind scaffold
// - `backend/` Express API scaffold
// - `demo/` Static HTML flow prototype
